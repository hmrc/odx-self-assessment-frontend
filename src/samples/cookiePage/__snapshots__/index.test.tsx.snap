          scope="col"
        >
          Name
        </th>
        <th
          class="govuk-table__header"
          scope="col"
        >
          Purpose
        </th>
        <th
          class="govuk-table__header"
          scope="col"
        >
          Expires
        </th>
      </tr>
    </thead>
    <tbody
      class="govuk-table__body"
    >
      <tr
        class="govuk-table__row"
      >
        <td
          class="govuk-table__cell"
        >
          AWSALB
        </td>
        <td
          class="govuk-table__cell"
        >
          Used to manage web traffic between your browser and the application servers that host this service
        </td>
        <td
          class="govuk-table__cell"
        >
          7 days
        </td>
      </tr>
      <tr
        class="govuk-table__row"
      >
        <td
          class="govuk-table__cell"
        >
          AWSALBCORS
        </td>
        <td
          class="govuk-table__cell"
        >
          Used to manage web traffic between your browser and the application servers that host this service
        </td>
        <td
          class="govuk-table__cell"
        >
          7 days
        </td>
      </tr>
      <tr
        class="govuk-table__row"
      >
        <td
          class="govuk-table__cell"
        >
          JSESSIONID
        </td>
        <td
          class="govuk-table__cell"
        >
          Used to identify your session information in relation to the service.
        </td>
        <td
          class="govuk-table__cell"
        >
          Session
        </td>
      </tr>
      <tr
        class="govuk-table__row"
      >
        <td
          class="govuk-table__cell"
        >
          AKA_A2
        </td>
        <td
          class="govuk-table__cell"
        >
          Used to speed up content delivery in the service through adaptive accelration.
        </td>
        <td
          class="govuk-table__cell"
        >
          1 hour
        </td>
      </tr>
    </tbody>
  </table>
  <p
    class="govuk-body"
  >
    Essential cookies keep your information secure while you use this service. We do not need to ask permission to use them.
  </p>
  <p
    class="govuk-body"
  >
    <a
      class="govuk-link govuk-link--no-visited-state"
      href="https://www.tax.service.gov.uk/help/cookie-details"
    >
      Find out more about cookies on HMRC services
    </a>
  </p>
</DocumentFragment>
`;

